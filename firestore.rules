rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
          'displayName', 'shortlist', 'comparison', 'flashcards', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.shortlist is list
        && request.resource.data.shortlist.size() <= 5002
        && request.resource.data.comparison is list
        && request.resource.data.comparison.size() <= 4
        && request.resource.data.flashcards is list
        && request.resource.data.flashcards.size() <= 500;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validProfile();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
